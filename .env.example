# --- Dataset / feature-scaler selection ---
# bus39          -> make_scaler_bus39
# eles/2026-01   -> make_scaler_eles
# interscada/pl  -> make_scaler_interscada_pl
# interscada/fr  -> make_scaler_interscada_fr
DATASET_NAME=eles/2026-01

# Base data directory used by src/domain/estimation/service.py
# Local default:
DATA_DIR=./data
# Docker example (set in container env if needed):
# DATA_DIR=/app/data

# --- Qdrant settings ---
QDRANT_URL=127.0.0.1
QDRANT_API_KEY=
# QDRANT_COLLECTION_PREFIX=states
# Optional explicit override; if empty, default is: {QDRANT_COLLECTION_PREFIX}_{DATASET_NAME}
# QDRANT_COLLECTION=
QDRANT_PREFER_GRPC=true
QDRANT_POPULATE_LOCK_PATH=/tmp/qdrant_populate.lock
QDRANT_POPULATE_LOCK_TIMEOUT=120.0

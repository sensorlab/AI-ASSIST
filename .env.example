# --- Dataset / feature-scaler selection ---
# bus39          -> make_scaler_bus39
# eles/2026-01   -> make_scaler_eles
# interscada/pl  -> make_scaler_interscada_pl
# interscada/fr  -> make_scaler_interscada_fr
DATASET_NAME=eles/2026-01

# Base data directory used by src/domain/estimation/service.py
# Local default:
DATA_DIR=./datasets
# Docker example (set in container env if needed):
# DATA_DIR=/app/datasets

# Console log verbosity (DEBUG/INFO/WARNING/ERROR). DEBUG adds per-file extraction logs,
# subprocess command lines, dtype dumps, etc.
LOG_LEVEL=INFO

# --- Topology matching ---
# Which switching-status columns define an exact topology match. Only eles/* has variants;
# bus39 and interscada/* carry a single unversioned topology_cols.json and ignore this.
#   lines_only    line-status flags only (907 cols, 1,785 groups on eles/2026-06) - the key
#                 the published results use, and the code default.
#   full          every switching flag including generator status (1,072 cols, 4,281 groups),
#                 which fragments the archive until almost nothing is retrievable.
#   slovenia_only a Slovenian-specific subset (254 cols) that is constant across the current
#                 data window, collapsing to 1 group - a no-filter control, not a coarser key.
# The value is folded into the Qdrant collection name, so switching it does not silently serve
# stale topology_id payloads from a previously populated collection.
TOPOLOGY_VARIANT=lines_only

# --- Qdrant settings ---
QDRANT_URL=127.0.0.1
QDRANT_API_KEY=
# QDRANT_COLLECTION_PREFIX=states
# Optional explicit override; if empty, default is: {QDRANT_COLLECTION_PREFIX}_{DATASET_NAME}
# QDRANT_COLLECTION=
QDRANT_PREFER_GRPC=true
QDRANT_POPULATE_LOCK_PATH=/tmp/qdrant_populate.lock
QDRANT_POPULATE_LOCK_TIMEOUT=120.0
